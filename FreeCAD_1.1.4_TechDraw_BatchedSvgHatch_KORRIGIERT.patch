 using DU = DrawUtil;
+
+// Experimental rendering-only A/B switch. Set to 0 for the original tile path.
+#ifndef TECHDRAW_BATCH_SVG_HATCH
+#define TECHDRAW_BATCH_SVG_HATCH 1
+#endif
+
+#if TECHDRAW_BATCH_SVG_HATCH
+namespace {
+
+// One Qt graphics item per hatch area instead of one QGraphicsSvgItem per tile.
+// The item holds a NON-owning reference to its parent QGIFace's QSvgRenderer.
+class BatchedSvgHatchRect final : public QGCustomRect
+{
+public:
+    BatchedSvgHatchRect()
+    {
+        setFlag(QGraphicsItem::ItemUsesExtendedStyleOption, true);
+    }
+
+    void resetTiles()
+    {
+        prepareGeometryChange();
+        m_renderer = nullptr;
+        m_tileCoverage = QRectF();
+        m_columns = 0;
+        m_rows = 0;
+        update();
+    }
+
+    void configureTiles(QSvgRenderer* renderer, int columns, int rows,
+                        qreal stepX, qreal stepY, QPointF offset,
+                        qreal initialY, qreal scale, long maxTiles)
+    {
+        prepareGeometryChange();
+        m_renderer = renderer;
+        m_columns = columns;
+        m_rows = rows;
+        m_stepX = stepX;
+        m_stepY = stepY;
+        m_origin = QPointF(offset.x(), initialY + offset.y());
+        m_limit = maxTiles + 1;  // Original implementation creates limit + 1 tiles.
+
+        const QSize nativeSize = renderer ? renderer->defaultSize() : QSize();
+        m_tileSize = QSizeF(nativeSize.width() * scale,
+                            nativeSize.height() * scale);
+        if (columns > 0 && rows > 0 && m_tileSize.width() > 0 && m_tileSize.height() > 0) {
+            m_tileCoverage = QRectF(m_origin,
+                QSizeF((columns - 1) * stepX + m_tileSize.width(),
+                       (rows - 1) * stepY + m_tileSize.height()));
+        } else {
+            m_tileCoverage = QRectF();
+        }
+        update();
+    }
+
+    QRectF boundingRect() const override
+    {
+        // Unlike child SVG items, painting within one item must advertise
+        // any area extending beyond the original hatch rectangle.
+        return QGCustomRect::boundingRect().united(m_tileCoverage);
+    }
+
+    void paint(QPainter* painter, const QStyleOptionGraphicsItem* option,
+               QWidget* widget = nullptr) override
+    {
+        QGCustomRect::paint(painter, option, widget);
+        if (!m_renderer || !m_renderer->isValid() ||
+            m_tileSize.isEmpty() || m_stepX <= 0 || m_stepY <= 0) {
+            return;
+        }
+
+        // Extended-style option exposes only the region Qt asks us to repaint.
+        const QRectF exposed = (option && option->exposedRect.isValid())
+            ? option->exposedRect : boundingRect();
+        long tileNumber = 0;
+        for (int x = 0; x < m_columns; ++x) {
+            for (int y = 0; y < m_rows; ++y) {
+                if (++tileNumber > m_limit) {
+                    return;
+                }
+                const QRectF tile(QPointF(m_origin.x() + x * m_stepX,
+                                         m_origin.y() + y * m_stepY),
+                                  m_tileSize);
+                if (tile.intersects(exposed)) {
+                    m_renderer->render(painter, tile);
+                }
+            }
+        }
+    }
+
+private:
+    QSvgRenderer* m_renderer{nullptr};  // owned by QGIFace
+    QRectF m_tileCoverage;
+    QPointF m_origin;
+    QSizeF m_tileSize;
+    int m_columns{0};
+    int m_rows{0};
+    qreal m_stepX{0};
+    qreal m_stepY{0};
+    long m_limit{0};
+};
+
+}  // namespace
+#endif
 
