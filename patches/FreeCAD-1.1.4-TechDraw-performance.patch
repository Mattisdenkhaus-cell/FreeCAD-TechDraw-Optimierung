index 0000000..eab58d7
--- /dev/null
+++ b/src/Mod/TechDraw/Gui/EdgeGeometryCache.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef TECHDRAWGUI_EDGEGEOMETRYCACHE_H
+#define TECHDRAWGUI_EDGEGEOMETRYCACHE_H
+
+#include <QPainterPath>
+#include <QPainterPathStroker>
+
+namespace TechDrawGui {
+
+// GUI-thread-only cache of the selection geometry, never of model geometry.
+// Keep a shared snapshot: even setPath() through QGraphicsPathItem is detected.
+// Qt compares shared QPainterPaths cheaply, and uses the same equality in setPath().
+class EdgeGeometryCache
+{
+public:
+    const QPainterPath& shape(const QPainterPath& path, qreal fuzz) const
+    {
+        refresh(path, fuzz);
+        return m_outline;
+    }
+
+    QRectF bounds(const QPainterPath& path, qreal fuzz) const
+    {
+        refresh(path, fuzz);
+        return m_bounds;
+    }
+
+private:
+    void refresh(const QPainterPath& path, qreal fuzz) const
+    {
+        if (m_valid && m_fuzz == fuzz && m_path == path) {
+            return;
+        }
+        QPainterPathStroker stroker;
+        stroker.setWidth(fuzz);
+        m_outline = stroker.createStroke(path);
+        m_bounds = m_outline.controlPointRect();
+        m_path = path;
+        m_fuzz = fuzz;
+        m_valid = true;
+    }
+
+    mutable QPainterPath m_path;
+    mutable QPainterPath m_outline;
+    mutable QRectF m_bounds;
+    mutable qreal m_fuzz{0};
+    mutable bool m_valid{false};
+};
+
+} // namespace TechDrawGui
+#endif
diff --git a/src/Mod/TechDraw/Gui/NavigationPreview.h b/src/Mod/TechDraw/Gui/NavigationPreview.h
new file mode 100644
index 0000000..a2f749f
--- /dev/null
+++ b/src/Mod/TechDraw/Gui/NavigationPreview.h
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef TECHDRAWGUI_NAVIGATIONPREVIEW_H
+#define TECHDRAWGUI_NAVIGATIONPREVIEW_H
+
+#include <QGraphicsScene>
+#include <QGraphicsView>
+#include <QImage>
+#include <QPainter>
+#include <QPointer>
+#include <QTimer>
+#include <cmath>
+
+namespace TechDrawGui {
+
+// GUI-thread-only, transient screen cache. Scene items and all geometry stay live.
+// QGraphicsScene::render and QGraphicsView::render never use this preview.
+class NavigationPreview : public QObject
+{
+public:
+    explicit NavigationPreview(QGraphicsView* view)
+        : QObject(view), m_view(view), m_scene(view->scene())
+    {
+        m_idle.setSingleShot(true);
+        m_idle.setInterval(120);
+        connect(&m_idle, &QTimer::timeout, this, [this] { invalidate(); });
+        if (m_scene) {
+            connect(m_scene, &QGraphicsScene::changed, this, [this] { invalidate(); });
+            connect(m_scene, &QGraphicsScene::selectionChanged, this, [this] { invalidate(); });
+            connect(m_scene, &QObject::destroyed, this, [this] { invalidate(); });
+        }
+    }
+
+    void invalidate()
+    {
+        const bool hadImage = !m_image.isNull();
+        m_idle.stop();
+        m_image = QImage();
+        if (hadImage)
+            m_view->viewport()->update(); // coalesced exact redraw, never synchronous repaint
+    }
+
+    bool begin()
+    {
+        if (!m_scene || m_view->scene() != m_scene || !m_view->isVisible() ||
+            !m_view->viewportTransform().isInvertible() ||
+            !m_view->viewport()->autoFillBackground())
+            return false;
+        const QBrush base = m_view->viewport()->palette().brush(m_view->viewport()->backgroundRole());
+        if (base.style() != Qt::SolidPattern || base.color().alpha() != 255)
+            return false;
+        if (!usable()) {
+            invalidate();
+            m_size = m_view->viewport()->size();
+            m_dpr = m_view->viewport()->devicePixelRatioF();
+            // One viewport plus 25% reserve on each side, bounded independently of scene size.
+            m_source = QRect(QPoint(), m_size).adjusted(-m_size.width() / 4, -m_size.height() / 4,
+                                                       m_size.width() / 4, m_size.height() / 4);
+            QSize pixels = rasterSize(m_source.size(), m_dpr);
+            if (pixels.isEmpty())
+                return false;
+            // Align the capture origin to physical pixels. An integer logical
+            // margin can otherwise introduce a second subpixel sampling at 125% DPI.
+            m_origin = QPointF(std::floor(m_source.x() * m_dpr) / m_dpr,
+                               std::floor(m_source.y() * m_dpr) / m_dpr);
+            pixels += QSize(1, 1); // room for the subpixel offset, also included in the budget
+            if (pixels.width() > 32768 || pixels.height() > 32768 ||
+                qint64(pixels.width()) * pixels.height() * 4 > maxBytes)
+                return false;
+            m_image = QImage(pixels, QImage::Format_RGB32);
+            if (m_image.isNull())
+                return false;
+            m_image.setDevicePixelRatio(m_dpr);
+            m_logicalDpi = QSize(m_view->viewport()->logicalDpiX(), m_view->viewport()->logicalDpiY());
+            m_image.setDotsPerMeterX(qRound(m_logicalDpi.width() / 0.0254));
+            m_image.setDotsPerMeterY(qRound(m_logicalDpi.height() / 0.0254));
+            // The widget backing store is opaque. RGB32 also preserves Qt's
+            // opaque-target text rasterization (ARGB can disable subpixel antialiasing).
+            m_image.fill(base.color());
+            m_transform = m_view->viewportTransform();
+            m_hints = m_view->renderHints();
+            m_baseBrush = base;
+            QPainter painter(&m_image);
+            painter.setRenderHints(m_hints);
+            // Match QWidget's erased backing store before the (possibly transparent)
+            // TechDraw background is painted. Never composite it twice over itself.
+            const QRectF target(QPointF(m_source.topLeft()) - m_origin, QSizeF(m_source.size()));
+            m_view->render(&painter, target, m_source, Qt::IgnoreAspectRatio);
+        }
+        m_idle.start();
+        return true;
+    }
+
+    bool paint(QPainter& painter)
+    {
+        if (!usable()) {
+            invalidate();
+            return false;
+        }
+        painter.save();
+        painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+        painter.setWorldTransform(m_transform.inverted() * m_view->viewportTransform());
+        // Preserve the image's device-pixel ratio. Stretching its rounded physical
+        // dimensions back into m_source would distort fractional-DPI captures.
+        painter.drawImage(m_origin, m_image);
+        painter.restore();
+        return true;
+    }
+
+    bool active() const { return !m_image.isNull(); }
+    qint64 bytes() const { return m_image.sizeInBytes(); }
+    static constexpr qint64 maxBytes = 64 * 1024 * 1024;
+    static QSize rasterSize(const QSize& logical, qreal dpr)
+    {
+        const double width = std::ceil(logical.width() * dpr);
+        const double height = std::ceil(logical.height() * dpr);
+        if (!(dpr > 0 && width > 0 && height > 0) || width > 32768 || height > 32768 ||
+            width * height * 4 > maxBytes)
+            return {};
+        return QSize(static_cast<int>(width), static_cast<int>(height));
+    }
+
+private:
+    bool usable() const
+    {
+        if (m_image.isNull() || !m_scene || m_view->scene() != m_scene ||
+            m_size != m_view->viewport()->size() ||
+            m_logicalDpi != QSize(m_view->viewport()->logicalDpiX(), m_view->viewport()->logicalDpiY()) ||
+            m_dpr != m_view->viewport()->devicePixelRatioF() || m_hints != m_view->renderHints() ||
+            !m_view->viewport()->autoFillBackground() ||
+            m_baseBrush != m_view->viewport()->palette().brush(m_view->viewport()->backgroundRole()))
+            return false;
+        bool invertible = false;
+        const QTransform inverse = (m_transform.inverted() * m_view->viewportTransform())
+                                       .inverted(&invertible);
+        // Require complete coverage, even for rotation/shear; otherwise draw exact vectors.
+        return invertible && QRectF(m_source).contains(
+            inverse.mapRect(QRectF(QPointF(), QSizeF(m_size))));
+    }
+
+    QGraphicsView* m_view;
+    QPointer<QGraphicsScene> m_scene;
+    QTimer m_idle;
+    QImage m_image;
+    QRect m_source;
+    QPointF m_origin;
+    QSize m_size;
+    QSize m_logicalDpi;
+    qreal m_dpr = 1;
+    QTransform m_transform;
+    QPainter::RenderHints m_hints;
+    QBrush m_baseBrush;
+};
+
+} // namespace TechDrawGui
+#endif
diff --git a/src/Mod/TechDraw/Gui/QGIBatchedSvgHatch.h b/src/Mod/TechDraw/Gui/QGIBatchedSvgHatch.h
new file mode 100644
index 0000000..613de41
--- /dev/null
+++ b/src/Mod/TechDraw/Gui/QGIBatchedSvgHatch.h
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef TECHDRAWGUI_QGIBATCHEDSVGHATCH_H
+#define TECHDRAWGUI_QGIBATCHEDSVGHATCH_H
+
+#include <algorithm>
+#include <cmath>
+#include <QPainter>
+#include <QPointer>
+#include <QStyleOptionGraphicsItem>
+#include <QSvgRenderer>
+#include "QGCustomRect.h"
+
+namespace TechDrawGui {
+
+// The QGIFace owns the renderer. A guarded pointer also makes destruction safe.
+// One graphics item replaces the original column-major array of SVG child items.
+class QGIBatchedSvgHatch final : public QGCustomRect
+{
+public:
+    QGIBatchedSvgHatch()
+    {
+        setFlag(QGraphicsItem::ItemUsesExtendedStyleOption, true);
+    }
+
+    ~QGIBatchedSvgHatch() override { QObject::disconnect(m_repaintConnection); }
+
+    void resetTiles()
+    {
+        prepareGeometryChange();
+        QObject::disconnect(m_repaintConnection);
+        m_renderer.clear();
+        m_coverage = QRectF();
+        m_count = 0;
+        update();
+    }
+
+    void configureTiles(QSvgRenderer* renderer, int columns, int rows,
+                        qreal stepX, qreal stepY, QPointF origin, qreal scale, long maxTiles)
+    {
+        resetTiles();
+        if (!renderer || !renderer->isValid() || columns <= 0 || rows <= 0 ||
+            !std::isfinite(stepX) || !std::isfinite(stepY) ||
+            !std::isfinite(scale) || !std::isfinite(origin.x()) ||
+            !std::isfinite(origin.y()) || stepX <= 0 || stepY <= 0 || scale <= 0) {
+            return;
+        }
+        const QSize native = renderer->defaultSize();
+        const QSizeF tile(native.width() * scale, native.height() * scale);
+        if (tile.isEmpty() || !std::isfinite(tile.width()) || !std::isfinite(tile.height())) {
+            return;
+        }
+        // Original code creates a tile, then tests tileCount > maxTiles.
+        const qint64 total = qint64(columns) * rows;
+        const qint64 count = std::min(total - 1, qint64(std::max(0L, maxTiles))) + 1;
+        const int usedColumns = int((count - 1) / rows + 1);
+        const int usedRows = int(std::min(count, qint64(rows)));
+        const QSizeF coverage((usedColumns - 1) * stepX + tile.width(),
+                              (usedRows - 1) * stepY + tile.height());
+        if (!std::isfinite(coverage.width()) || !std::isfinite(coverage.height()) ||
+            !std::isfinite(origin.x() + coverage.width()) ||
+            !std::isfinite(origin.y() + coverage.height())) {
+            return;
+        }
+        prepareGeometryChange();
+        m_renderer = renderer;
+        m_repaintConnection = QObject::connect(renderer, &QSvgRenderer::repaintNeeded,
+                                               [this]() { update(); });
+        m_columns = usedColumns;
+        m_rows = rows;
+        m_count = count;
+        m_stepX = stepX;
+        m_stepY = stepY;
+        m_origin = origin;
+        m_scale = scale;
+        m_nativeSize = native;
+        m_tileSize = tile;
+        m_coverage = QRectF(origin, coverage);
+        update();
+    }
+
+    QRectF boundingRect() const override
+    {
+        return QGCustomRect::boundingRect().united(m_coverage);
+    }
+
+    // Keep upstream placement independent of the extra advertised tile coverage.
+    void centerAt(QPointF center) override { centerAt(center.x(), center.y()); }
+    void centerAt(double x, double y) override
+    {
+        const QRectF box = QGCustomRect::boundingRect();
+        setPos(x - box.width() / 2, y - box.height() / 2);
+    }
+
+    // Public to permit a Qt-only equivalence/complexity test without GUI bindings.
+    template<class Visitor>
+    void forEachVisibleTile(const QRectF& exposed, Visitor visit) const
+    {
+        if (!m_count || !exposed.intersects(m_coverage)) {
+            return;
+        }
+        // Inclusive conservative ranges, followed by the original intersection test.
+        // Clamp as floating point BEFORE converting to int, including extreme pans.
+        const auto index = [](qreal value, int size) {
+            return int(std::max(qreal(0), std::min(qreal(size - 1), value)));
+        };
+        const int x0 = index(std::floor((exposed.left() - m_origin.x() - m_tileSize.width()) / m_stepX), m_columns);
+        const int x1 = index(std::ceil((exposed.right() - m_origin.x()) / m_stepX), m_columns);
+        const int y0 = index(std::floor((exposed.top() - m_origin.y() - m_tileSize.height()) / m_stepY), m_rows);
+        const int y1 = index(std::ceil((exposed.bottom() - m_origin.y()) / m_stepY), m_rows);
+        for (int x = x0; x <= x1; ++x) {
+            const qint64 remaining = m_count - qint64(x) * m_rows;
+            const int lastRow = int(std::min(qint64(y1), remaining - 1));
+            for (int y = y0; y <= lastRow; ++y) {
+                const QPointF position(m_origin.x() + x * m_stepX, m_origin.y() + y * m_stepY);
+                if (QRectF(position, m_tileSize).intersects(exposed)) {
+                    visit(position);
+                }
+            }
+        }
+    }
+
+    void paint(QPainter* painter, const QStyleOptionGraphicsItem* option,
+               QWidget* widget = nullptr) override
+    {
+        QGCustomRect::paint(painter, option, widget);
+        if (!m_renderer || !m_renderer->isValid()) {
+            return;
+        }
+        const QRectF exposed = option && option->exposedRect.isValid()
+            ? option->exposedRect : boundingRect();
+        forEachVisibleTile(exposed, [&](const QPointF& position) {
+            // Match QGraphicsSvgItem's local transform, including cosmetic SVG strokes.
+            painter->save();
+            painter->translate(position);
+            painter->scale(m_scale, m_scale);
+            m_renderer->render(painter, QRectF(QPointF(), m_nativeSize));
+            painter->restore();
+        });
+    }
+
+private:
+    QPointer<QSvgRenderer> m_renderer;
+    QMetaObject::Connection m_repaintConnection;
+    QRectF m_coverage;
+    QPointF m_origin;
+    QSizeF m_nativeSize;
+    QSizeF m_tileSize;
+    int m_columns{0};
+    int m_rows{0};
+    qint64 m_count{0};
+    qreal m_stepX{0};
+    qreal m_stepY{0};
+    qreal m_scale{1};
+};
+
+} // namespace TechDrawGui
+#endif
